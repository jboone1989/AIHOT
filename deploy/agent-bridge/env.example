# ~/.config/agent-bridge/env on server142. No secrets here: Codex and gh keep their own logins.
AGENT_BRIDGE_REPO=jboone1989/AIHOT
AGENT_BRIDGE_WORKDIR=/home/ubuntu/agent-bridge
AGENT_BRIDGE_MAX_ROUNDS=6
AGENT_BRIDGE_CODEX_TIMEOUT=45m
# systemd does not read the login shell's PATH; keep the directory that holds codex and npm.
PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
# The host proxy for OpenAI and GitHub on cn-dev.
HTTPS_PROXY=http://127.0.0.1:18123
HTTP_PROXY=http://127.0.0.1:18123
NO_PROXY=127.0.0.1,localhost
