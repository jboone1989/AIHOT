# ChatGPT side of the agent bridge (docs/agent-collab.md). Installed as a systemd user unit on server142.
[Unit]
Description=Codex worker for GitHub issues and PRs labelled agent:codex
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/agent-bridge/env
ExecStart=%h/.local/bin/codex-worker.sh
TimeoutStartSec=2h
