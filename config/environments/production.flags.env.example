# Production: non-secret feature flags. Merge explicitly into private .env on production host.
# The NVIDIA key and base URL must be configured before enabling model calls.
AIHOT_ENVIRONMENT=production
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true
NVIDIA_MODEL_POOL_ENABLED=true
NVIDIA_MODEL_DISCOVERY_PROBES_ENABLED=true
GRAPHITI_INGEST_ENABLED=true
ADSENSE_VERIFICATION_ENABLED=false
